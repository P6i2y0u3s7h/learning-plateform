# ==============================================================
# Brainstorm Academy — Client Environment Variables Template
# ==============================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (or '.env.local' for local development):
#    cp .env.example .env.local
# 2. Replace the placeholder values with your actual project credentials.
# 3. DO NOT commit '.env' or '.env.local' to source control.
#
# IMPORTANT SECURITY NOTICE:
# - All variables prefixed with 'VITE_' are embedded into the client-side JavaScript bundle!
# - They will be publicly visible to anyone inspecting network traffic or application assets.
# - NEVER put secret keys here, such as:
#     * Razorpay Key Secret
#     * Firebase Admin SDK service account private keys
#     * Database administrative tokens
# ==============================================================

# Application Branding
VITE_APP_NAME="Brainstorm Academy"
VITE_APP_TAGLINE="Learn Today. Lead Tomorrow."

# API Gateway (Optional custom backend URL for proxy or microservices)
VITE_API_BASE_URL="http://localhost:5000/api"

# --------------------------------------------------------------
# Firebase Web Client Configuration (Required)
# --------------------------------------------------------------
# Obtain these values from Firebase Console:
# https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app (</>)
# --------------------------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# --------------------------------------------------------------
# Cloud Functions Settings
# --------------------------------------------------------------
# Default region for deployed functions (e.g., us-central1, asia-south1)
VITE_FIREBASE_FUNCTIONS_REGION="us-central1"

# --------------------------------------------------------------
# Firebase Cloud Messaging (Web Push Notifications - Optional)
# --------------------------------------------------------------
# Obtain VAPID key from: Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY="your-web-push-vapid-key"

# --------------------------------------------------------------
# Firebase Local Emulators Configuration (Development Only)
# --------------------------------------------------------------
# Set to 'true' to redirect Auth, Firestore, RTDB, Storage, and Functions to localhost
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"

# --------------------------------------------------------------
# Razorpay Payment Gateway (Public Key ID Only)
# --------------------------------------------------------------
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Use 'rzp_test_...' for development/testing, 'rzp_live_...' for production.
# WARNING: NEVER expose Razorpay Key Secret here! Key Secret belongs on the backend.
VITE_RAZORPAY_KEY_ID="rzp_test_your_test_key_id"
